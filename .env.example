# Database connection string.
#
# Local development: use a local PostgreSQL instance (recommended) or change
# the provider in prisma/schema.prisma to "sqlite" and use a file path.
#
# Production (Vercel + Supabase):
#   DATABASE_URL="postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@db.xxxxxx.supabase.co:5432/postgres?schema=public"
#
# The Prisma schema has provider = "postgresql" matching the production target.
# To use SQLite locally, change the provider line in prisma/schema.prisma to
# "sqlite" and set DATABASE_URL to a file path like "file:./prisma/dev.db".
DATABASE_URL="postgresql://tsnx:@localhost:5433/acritmaison?schema=public"

# Public site URL (used for SEO canonical URLs, sitemap, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin account, created by `npm run db:seed`.
# Change these before first deployment.
ADMIN_EMAIL="admin@acritmaison.example"
ADMIN_PASSWORD="change-me-immediately"

# Stripe — optional. When these are absent, card payments are disabled and the
# storefront checkout clearly says so (no simulated payments are ever created).
# With them set, checkout creates a real Stripe Checkout Session and the
# /api/webhooks/stripe endpoint verifies signatures before marking orders paid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional email (Resend) — optional. Without a key, emails are written
# to the server log instead of being sent. With a key set, password resets,
# order confirmations and status updates send for real.
# Use onboarding@resend.dev as the FROM address until your own domain is
# verified in the Resend dashboard.
RESEND_API_KEY=""
RESEND_EMAIL_FROM="onboarding@resend.dev"
